# GeoPulse Stream Processor Configuration

# Kafka broker address
KAFKA_BROKER=localhost:9092

# Redis. The password must match --requirepass in infra/docker-compose.yml; it is a dev
# credential whose job is to make a wrong connection fail instead of silently succeeding.
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=geopulse-dev

# How much event time may pass before a still-degraded zone re-publishes its degradation.
#
# The correlation window drops a member CORRELATION_WINDOW_MS (120s) after its last degradation,
# and this service only emits on state CHANGES — so without this a zone that degrades and stays
# degraded is forgotten mid-fault and the incident closes underneath it. That was defect D14; see
# docs/adr/ADR-008. Must stay comfortably below the correlation window. 0 disables it, which
# reproduces D14.
DEGRADATION_REASSERT_MS=30000

# Bounded in-process retry for a failed sensor event. Exhausted retries DROP the event (counted
# in sensor_events_dropped_total) rather than dead-lettering it - see ADR-000's amendment.
SENSOR_MAX_ATTEMPTS=3
SENSOR_INITIAL_BACKOFF_MS=50
SENSOR_BACKOFF_MULTIPLIER=3
SENSOR_MAX_BACKOFF_MS=500

# Bounded retry for publishing a degradation. Exhausted retries DEAD-LETTER it: a degradation is
# a derived fact that nothing re-emits within the window, unlike the samples it came from.
DEGRADATION_MAX_ATTEMPTS=4
DEGRADATION_INITIAL_BACKOFF_MS=100
DEGRADATION_BACKOFF_MULTIPLIER=3
DEGRADATION_MAX_BACKOFF_MS=5000
