# GeoPulse Correlation Engine Configuration

# Kafka
KAFKA_BROKER=localhost:9092
DEGRADATIONS_TOPIC=zone.degradations
INCIDENTS_TOPIC=zone.incidents
CORRELATION_CONSUMER_GROUP=correlation-engine
# True replays the topic from its start, which is what a reproducible eval run needs. Set false
# for a long-lived deployment: replaying months of degradations re-derives every incident that
# ever happened.
CORRELATION_FROM_BEGINNING=true
CORRELATION_MAX_BATCH_SIZE=1000

# Correlation geometry. These four decide whether the project's central claim is true or false,
# so a benchmark must record them alongside any number it reports.
CORRELATION_WINDOW_MS=120000
COMPACTION_INTERVAL_MS=5000
INCIDENT_MIN_ZONES=3
INCIDENT_CLOSE_GRACE_MS=60000

# Zone registry poll. 0 disables it; inline discovery from degradation messages still works.
ZONE_REFRESH_INTERVAL_MS=60000

# Redis. The password must match --requirepass in infra/docker-compose.yml; it is a dev
# credential whose job is to make a wrong connection fail instead of silently succeeding.
REDIS_HOST=localhost
REDIS_PORT=6390
REDIS_PASSWORD=geopulse-dev
# TTL on a closed incident's hash. Redis is a cache of the present; Postgres is the archive.
CLOSED_INCIDENT_TTL_SECONDS=3600

METRICS_PORT=9093
LOG_LEVEL=info
