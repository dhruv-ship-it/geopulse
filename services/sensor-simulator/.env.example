# GeoPulse Sensor Simulator Configuration

# Number of geographic zones to simulate
NUM_ZONES=10

# Scenario type.
#   normal | spike | drop            load profiles; no faults injected, no ground truth
#   regional-anomaly                 one stationary regional fault
#   propagating-anomaly              a front crossing the field at a known bearing and speed
#   multi-anomaly                    two disjoint faults - catches OVER-grouping
#   noise                            scattered single-zone degradations - catches hallucinated
#                                    incidents; the correct answer here is zero incidents
# An unrecognised value is rejected rather than quietly treated as `normal`.
SCENARIO=spike

# Log progress every N events
LOG_EVERY_N=100

# ============================================
# Simulated time (see src/virtualClock.ts)
# ============================================
# All zones share one virtual clock. Event time is a function of the tick count, never of the
# wall clock, so a run reproduces byte for byte at any speed.

# Simulated epoch the run starts at. 2026-01-15T12:00:00Z.
SIM_START_EPOCH_MS=1768478400000

# Simulated milliseconds per tick. One event per zone per tick, so this is the sample interval.
SIM_STEP_MS=1000

# Simulated milliseconds per real millisecond. 60 = a simulated minute every real second, which
# is what makes a 60s STRESSED confirmation window observable in a one-second run.
SPEED_MULTIPLIER=1

# Real event rate = NUM_ZONES * (1000 / SIM_STEP_MS) * SPEED_MULTIPLIER events per real second.

# Kafka broker address
KAFKA_BROKER=localhost:9092

# ============================================
# Eval scenarios (see docs/03-MEASUREMENT.md)
# ============================================
# These only apply when SCENARIO is one of the four anomaly scenarios.

# Seeds every arbitrary choice in the run: zone jitter and base loads, anomaly placement,
# bearing and speed, which zones the noise scenario picks. The same seed reproduces the run
# byte for byte; a different seed gives genuinely different geometry. Embedded in the run id.
SEED=42

# Zone placement.
#   global-spiral   fibonacci spiral over the whole planet (the original)
#   regional-grid   a jittered grid filling a bounded region
# Anomaly scenarios default to regional-grid and cannot work without it: on the spiral the
# closest pair of zones is 160 km apart even at 5000 zones, so no zone has a neighbour and there
# is nothing to correlate. Measured in benchmarks/results/d9-zone-spacing.txt.
# ZONE_LAYOUT=regional-grid

# The region regional-grid fills. 400 km around Berlin by default. With 400 zones that puts the
# median nearest neighbour at 15.7 km, comfortably inside an H3 res-5 neighbour ring.
# ZONE_REGION_CENTRE_LAT=52.31
# ZONE_REGION_CENTRE_LON=13.04
# ZONE_REGION_EXTENT_KM=400

# Simulated duration of an eval run. Four simulated hours, which is long enough for a front at
# 40 km/h to sweep 160 km across the region. At SPEED_MULTIPLIER=3600 that is ~4 real minutes.
# RUN_DURATION_MS=14400000

# Where ground truth is written. Relative paths resolve against the repo root.
# GROUNDTRUTH_DIR=evals/groundtruth

# Overrides the derived run id. Leave unset: the derived id is a pure function of the simulated
# start epoch, scenario and seed, which is what keeps two runs of one configuration identical.
# RUN_ID=

# Write the ground truth and exit without producing any events. Useful for inspecting what a
# seed would inject before committing to a full run.
# PLAN_ONLY=1

# A meaningful eval run needs enough zones for an anomaly to cover several of them.
# NUM_ZONES=400 is the reference configuration; below ~100 zones no zone has a neighbour and
# every incident is a singleton regardless of how the correlation engine behaves. The simulator
# warns at startup when the field it is given is too sparse.
