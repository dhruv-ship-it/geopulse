# GeoPulse Environment Configuration

# ============================================
# Kafka Configuration
# ============================================
KAFKA_BROKER=localhost:9092

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6390
# Dev credential, not a secret. It exists so that a service pointed at the wrong Redis fails
# AUTH loudly instead of quietly sharing another project's keyspace. Must match the
# --requirepass value in infra/docker-compose.yml.
REDIS_PASSWORD=geopulse-dev

# ============================================
# PostgreSQL Configuration (Phase 5)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=geopulse
POSTGRES_USER=geopulse
POSTGRES_PASSWORD=geopulse

# ============================================
# API Server Configuration
# ============================================
PORT=3000

# ============================================
# Alert Processor Configuration
# ============================================
ALERT_HISTORY_LIMIT=100
ALERT_GLOBAL_LIMIT=1000
